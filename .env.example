# Copy to .env and fill in your own values (DevTools on a logged-in vinted session).
# All values are SECRETS — .env is gitignored, never commit it.
# To keep this file elsewhere, set VINTED_ENV_FILE=/path/to/file in the environment.

# Market: selects www.vinted.<domain> and its settings in config/markets.json
# (currency, locale, local condition names, brand prices...). E.g. it, se.
VINTED_DOMAIN=se
VINTED_USER_ID=
VINTED_ACCOUNT_ID=

# Cookies (DevTools > Application > Cookies > https://www.vinted.<domain>)
VINTED_ACCESS_TOKEN_WEB=
VINTED_REFRESH_TOKEN_WEB=
VINTED_COOKIE_VINTED_SESSION=
VINTED_COOKIE_DATADOME=
VINTED_COOKIE_ANON_ID=

# Header tokens (DevTools > Network > any /api/v2 request > Request Headers)
VINTED_CSRF_TOKEN=
VINTED_ANON_ID=

# Optional per-setting overrides of config/markets.json (leave empty to use the file)
VINTED_CURRENCY=
VINTED_LOCALE=
VINTED_ACCEPT_LANGUAGE=
VINTED_PRICE_FORMAT=
VINTED_PREFERRED_CATALOG_ROOT=
VINTED_SIZE_GROUP=
