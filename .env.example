# Copy to .env and fill in your own values (DevTools on a logged-in vinted session).
# All values are SECRETS — .env is gitignored, never commit it.

VINTED_DOMAIN=se
VINTED_USER_ID=
VINTED_ACCOUNT_ID=

# Cookies (DevTools > Application > Cookies > https://www.vinted.<domain>)
VINTED_ACCESS_TOKEN_WEB=
VINTED_REFRESH_TOKEN_WEB=
VINTED_COOKIE_VINTED_SESSION=
VINTED_COOKIE_DATADOME=
VINTED_COOKIE_ANON_ID=

# Header tokens (DevTools > Network > any /api/v2 request > Request Headers)
VINTED_CSRF_TOKEN=
VINTED_ANON_ID=
